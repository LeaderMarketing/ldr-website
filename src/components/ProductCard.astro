---
import { type Product, keySpecs, formatRRP, productUrl, TYPE_LABEL, GROUP_LABEL } from '../lib/catalog';
import ProductImage from './ProductImage.astro';
interface Props { product: Product }
const { product: p } = Astro.props;
const price = formatRRP(p);
const isRack = p.kind === 'rack';
const search = [p.sku, p.name, p.leaderName ?? '', isRack ? TYPE_LABEL[p.type] : GROUP_LABEL[p.group]].join(' ').toLowerCase();
const specs = keySpecs(p);
---
<article class="pcard" data-range={p.range} data-kind={p.kind} data-type={isRack ? p.type : p.group}
  data-ru={p.ru ?? ''} data-width={isRack ? p.width ?? '' : ''} data-depth={isRack ? p.depth ?? '' : ''}
  data-door={isRack ? p.door ?? '' : ''} data-search={search}>
  <a href={productUrl(p)} class="pcard-link">
    <ProductImage product={p} />
    <div class="pcard-body">
      <div class="pcard-badges">
        {p.range === 'carbon' ? <span class="badge badge--carbon">Carbon</span> : <span class="badge">LDR</span>}
        {p.isNew && <span class="badge badge--new">New</span>}
      </div>
      <h3>{p.name}</h3>
      <p class="sku">{p.sku}</p>
      {specs && <p class="pcard-specs">{specs}</p>}
      <p class="pcard-price">{price ? <><strong>{price}</strong> <span class="muted">RRP</span></> : <span class="muted">Price on request</span>}</p>
    </div>
  </a>
</article>
<style>
  .pcard { border: 1px solid var(--line); border-radius: var(--radius-lg); background: #fff; overflow: hidden; transition: border-color .15s, box-shadow .15s; }
  .pcard:hover { border-color: var(--line-strong); box-shadow: var(--shadow); }
  .pcard-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .pcard-body { padding: 14px 16px 16px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .pcard-badges { display: flex; gap: 6px; margin-bottom: 4px; }
  .pcard h3 { font-size: 1rem; margin: 0; letter-spacing: -.005em; }
  .pcard .sku { margin: 0; font-size: .75rem; }
  .pcard-specs { margin: 2px 0 0; font-size: .875rem; color: var(--ink-2); }
  .pcard-price { margin: auto 0 0; padding-top: 10px; font-size: .875rem; }
</style>
