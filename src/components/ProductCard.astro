---
import { type Product, keySpecs, formatRRP, productUrl, TYPE_LABEL, GROUP_LABEL } from '../lib/catalog';
import ProductImage from './ProductImage.astro';
interface Props { product: Product }
const { product: p } = Astro.props;
const price = formatRRP(p);
const isRack = p.kind === 'rack';
const search = [p.sku, p.name, p.leaderName ?? '', isRack ? TYPE_LABEL[p.type] : GROUP_LABEL[p.group]].join(' ').toLowerCase();
const specs = keySpecs(p);
---
<article class="pcard" data-range={p.range} data-kind={p.kind} data-type={isRack ? p.type : p.group}
  data-ru={p.ru ?? ''} data-width={isRack ? p.width ?? '' : ''} data-depth={isRack ? p.depth ?? '' : ''}
  data-door={isRack ? p.door ?? '' : ''} data-search={search}>
  <a href={productUrl(p)} class="pcard-link">
    <ProductImage product={p} />
    <div class="pcard-body">
      <div class="pcard-badges">
        {p.range === 'carbon' ? <span class="badge badge--carbon">Carbon</span> : <span class="badge">LDR</span>}
        {p.isNew && <span class="badge badge--new">New</span>}
      </div>
      <h3>{p.name}</h3>
      <p class="sku">{p.sku}</p>
      {specs && <p class="pcard-specs">{specs}</p>}
      <p class="pcard-price">{price ? <><strong>{price}</strong> <span class="muted">RRP</span></> : <span class="muted">Price on request</span>}</p>
    </div>
  </a>
</article>
<style>
  .pcard { height: 100%; border-radius: var(--radius-lg); background: var(--paper-2); overflow: hidden; transition: background .3s, box-shadow .5s var(--ease), transform .5s var(--ease); }
  .pcard:hover { background: #fff; box-shadow: var(--shadow); transform: translateY(-3px); }
  .pcard:hover :global(.pimg img) { transform: scale(1.05); }
  :global(.section--tint) .pcard { background: #fff; }
  .pcard-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .pcard-body { padding: 2px 20px 20px; display: flex; flex-direction: column; gap: 3px; flex: 1; }
  .pcard-badges { display: flex; gap: 5px; margin-bottom: 8px; }
  .pcard-badges .badge { background: rgb(0 0 0 / .06); }
  .pcard-badges .badge--carbon { background: var(--ink); }
  .pcard-badges .badge--new { background: var(--accent-soft); }
  .pcard h3 { font-size: 1rem; line-height: 1.25; letter-spacing: -.015em; margin: 0; }
  .pcard .sku { margin: 0; font-size: .7rem; }
  .pcard-specs { margin: 4px 0 0; font-size: .8125rem; color: var(--muted); }
  .pcard-price { margin: auto 0 0; padding-top: 12px; font-size: .8125rem; }
  .pcard-price strong { font-size: 1rem; font-weight: 600; }
  @media (max-width: 560px) {
    .pcard { border-radius: 16px; }
    .pcard-body { padding: 0 12px 14px; }
    .pcard h3 { font-size: .875rem; }
    .pcard .sku { font-size: .62rem; overflow-wrap: anywhere; }
    .pcard-specs { font-size: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .pcard, .pcard:hover { transform: none; transition: none; } }
</style>
