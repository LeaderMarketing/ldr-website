---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, racks, accessories, TYPE_LABEL, GROUP_LABEL, type RackType, type AccGroup } from '../../lib/catalog';

const uniq = <T,>(a: T[]) => [...new Set(a)].filter((v) => v != null && v !== '') as T[];
const rackTypes = uniq(racks.map((r) => r.type)) as RackType[];
const accGroups = uniq(accessories.map((a) => a.group)) as AccGroup[];
const rus = uniq(racks.map((r) => r.ru)).sort((a, b) => a - b);
const widths = uniq(racks.map((r) => r.width)).sort((a, b) => (a ?? 0) - (b ?? 0));
const depths = uniq(racks.map((r) => r.depth)).sort((a, b) => (a ?? 0) - (b ?? 0));
const countBy = (f: (p: (typeof products)[number]) => boolean) => products.filter(f).length;
---
<Base title="Products" description="Browse every LDR rack, cabinet and accessory. Filter by type, rack units, width, depth and door.">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">/</span>Products</nav>
    <header class="cat-head">
      <h1 id="cat-title">All products</h1>
      <p class="lede">Every LDR rack, cabinet and accessory, including the new Carbon range.</p>
    </header>

    <div class="cat-layout">
      <aside class="filters" aria-label="Filters">
        <form id="filters">
          <div class="field">
            <label for="f-q">Search</label>
            <input id="f-q" name="q" type="search" class="input" placeholder="SKU, size or name" autocomplete="off" />
          </div>

          <fieldset>
            <legend>Show</legend>
            <label class="opt"><input type="radio" name="kind" value="" checked /> Everything <span>{products.length}</span></label>
            <label class="opt"><input type="radio" name="kind" value="rack" /> Racks & cabinets <span>{racks.length}</span></label>
            <label class="opt"><input type="radio" name="kind" value="accessory" /> Accessories <span>{accessories.length}</span></label>
          </fieldset>

          <fieldset>
            <legend>Range</legend>
            <label class="opt"><input type="checkbox" name="range" value="carbon" /> Carbon <span>{countBy((p) => p.range === 'carbon')}</span></label>
            <label class="opt"><input type="checkbox" name="range" value="classic" /> LDR <span>{countBy((p) => p.range === 'classic')}</span></label>
          </fieldset>

          <fieldset data-for="rack">
            <legend>Cabinet type</legend>
            {rackTypes.map((t) => <label class="opt"><input type="checkbox" name="type" value={t} /> {TYPE_LABEL[t]} <span>{racks.filter((r) => r.type === t).length}</span></label>)}
          </fieldset>

          <fieldset data-for="accessory">
            <legend>Accessory type</legend>
            {accGroups.map((g) => <label class="opt"><input type="checkbox" name="type" value={g} /> {GROUP_LABEL[g]} <span>{accessories.filter((a) => a.group === g).length}</span></label>)}
          </fieldset>

          <fieldset data-for="rack">
            <legend>Rack units</legend>
            <div class="chips">{rus.map((u) => <label class="chip"><input type="checkbox" name="ru" value={u} /><span>{u}U</span></label>)}</div>
          </fieldset>

          <fieldset data-for="rack">
            <legend>Width (mm)</legend>
            <div class="chips">{widths.map((w) => <label class="chip"><input type="checkbox" name="width" value={w} /><span>{w}</span></label>)}</div>
          </fieldset>

          <fieldset data-for="rack">
            <legend>Depth (mm)</legend>
            <div class="chips">{depths.map((d) => <label class="chip"><input type="checkbox" name="depth" value={d} /><span>{d}</span></label>)}</div>
          </fieldset>

          <fieldset data-for="rack">
            <legend>Front door</legend>
            <label class="opt"><input type="checkbox" name="door" value="glass" /> Glass</label>
            <label class="opt"><input type="checkbox" name="door" value="mesh" /> Mesh</label>
          </fieldset>

          <button type="reset" class="btn btn--secondary btn--small" id="f-reset">Clear filters</button>
        </form>
      </aside>

      <section aria-labelledby="cat-title">
        <div class="results-bar">
          <p id="count" aria-live="polite"><strong>{products.length}</strong> products</p>
          <div class="results-tools">
            <button type="button" class="btn btn--secondary btn--small filters-toggle" aria-controls="filters" aria-expanded="false">Filters</button>
            <label for="sort" class="visually-hidden">Sort</label>
            <select id="sort" class="select sort">
              <option value="default">Sort: type & size</option>
              <option value="ru">Rack units</option>
              <option value="price-asc">Price, low to high</option>
              <option value="price-desc">Price, high to low</option>
              <option value="new">Newest first</option>
            </select>
          </div>
        </div>
        <div class="grid grid--3" id="results">
          {products.map((p, i) => <div class="cell" data-i={i} data-price={p.rrp ?? ''} data-new={p.isNew ? 1 : 0}><ProductCard product={p} /></div>)}
        </div>
        <div id="empty" class="empty" hidden>
          <h2>No products match</h2>
          <p class="muted">Try removing a filter, or let the <a href={url('/rack-builder')}>Rack Builder</a> find the closest match for your equipment.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement;
  const results = document.getElementById('results')!;
  const cells = [...results.querySelectorAll<HTMLElement>('.cell')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const title = document.getElementById('cat-title')!;
  const MULTI = ['range', 'type', 'ru', 'width', 'depth', 'door'];

  function readUrl() {
    const sp = new URLSearchParams(location.search);
    (form.elements.namedItem('q') as HTMLInputElement).value = sp.get('q') ?? '';
    const kind = sp.get('kind') ?? '';
    form.querySelectorAll<HTMLInputElement>('input[name=kind]').forEach((i) => (i.checked = i.value === kind));
    for (const k of MULTI) {
      const vals = (sp.get(k) ?? '').split(',').filter(Boolean);
      form.querySelectorAll<HTMLInputElement>(`input[name=${k}]`).forEach((i) => (i.checked = vals.includes(i.value)));
    }
    sort.value = sp.get('sort') ?? 'default';
  }

  function state() {
    const fd = new FormData(form);
    const s: Record<string, string[]> = {};
    for (const k of MULTI) s[k] = fd.getAll(k) as string[];
    return { q: String(fd.get('q') ?? '').trim().toLowerCase(), kind: String(fd.get('kind') ?? ''), ...s };
  }

  function apply(push = true) {
    const s = state() as any;
    // Type options only make sense for the chosen kind.
    form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-for]').forEach((fs) => {
      fs.hidden = !!s.kind && fs.dataset.for !== s.kind;
    });
    let shown = 0;
    for (const c of cells) {
      const d = (c.firstElementChild as HTMLElement).dataset;
      const terms = s.q.split(/\s+/).filter(Boolean);
      const ok =
        (!s.kind || d.kind === s.kind) &&
        (!s.range.length || s.range.includes(d.range)) &&
        (!s.type.length || s.type.includes(d.type)) &&
        (!s.ru.length || s.ru.includes(d.ru)) &&
        (!s.width.length || s.width.includes(d.width)) &&
        (!s.depth.length || s.depth.includes(d.depth)) &&
        (!s.door.length || s.door.includes(d.door)) &&
        terms.every((t: string) => d.search!.includes(t));
      c.hidden = !ok;
      if (ok) shown++;
    }
    count.innerHTML = `<strong>${shown}</strong> ${shown === 1 ? 'product' : 'products'}`;
    empty.hidden = shown > 0;
    title.textContent = s.kind === 'rack' ? 'Racks & cabinets' : s.kind === 'accessory' ? 'Accessories' : 'All products';

    const key = sort.value;
    const sorted = [...cells].sort((a, b) => {
      const pa = parseFloat(a.dataset.price || ''), pb = parseFloat(b.dataset.price || '');
      const ia = +a.dataset.i!, ib = +b.dataset.i!;
      if (key === 'ru') return (+((a.firstElementChild as HTMLElement).dataset.ru || 0) - +((b.firstElementChild as HTMLElement).dataset.ru || 0)) || ia - ib;
      if (key === 'price-asc') return (isNaN(pa) ? 1e9 : pa) - (isNaN(pb) ? 1e9 : pb) || ia - ib;
      if (key === 'price-desc') return (isNaN(pb) ? -1 : pb) - (isNaN(pa) ? -1 : pa) || ia - ib;
      if (key === 'new') return +b.dataset.new! - +a.dataset.new! || ia - ib;
      return ia - ib;
    });
    sorted.forEach((c) => results.appendChild(c));

    if (push) {
      const sp = new URLSearchParams();
      if (s.q) sp.set('q', s.q);
      if (s.kind) sp.set('kind', s.kind);
      for (const k of MULTI) if (s[k].length) sp.set(k, s[k].join(','));
      if (key !== 'default') sp.set('sort', key);
      history.replaceState(null, '', sp.toString() ? `?${sp}` : location.pathname);
    }
  }

  form.addEventListener('input', () => apply());
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('reset', () => setTimeout(() => apply()));
  sort.addEventListener('change', () => apply());
  const toggle = document.querySelector<HTMLButtonElement>('.filters-toggle')!;
  toggle.addEventListener('click', () => {
    const open = document.body.classList.toggle('filters-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  readUrl();
  apply(false);
</script>

<style>
  .cat-head { padding: 18px 0 4px; }
  .cat-head h1 { font-size: clamp(2rem, 4.4vw, 3.25rem); margin-bottom: .25em; }
  .cat-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 44px; padding: 28px 0 96px; align-items: start; }
  .filters { position: sticky; top: calc(var(--header-h) + 20px); max-height: calc(100vh - var(--header-h) - 40px); overflow: auto; padding: 2px 8px 2px 2px; scrollbar-width: thin; }
  .filters form { display: grid; gap: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 2px; }
  fieldset[hidden] { display: none; }
  legend { font-weight: 600; font-size: .8125rem; margin-bottom: 8px; padding: 0; }
  .opt { display: flex; align-items: center; gap: 9px; font-size: .875rem; padding: 4px 0; cursor: pointer; }
  .opt span { margin-left: auto; font-size: .75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .opt input { width: 16px; height: 16px; margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: inline-flex; min-width: 46px; height: 32px; padding: 0 10px; align-items: center; justify-content: center; border-radius: 999px; background: var(--paper-2); font-size: .8125rem; font-weight: 500; font-variant-numeric: tabular-nums; cursor: pointer; transition: background .2s, color .2s; }
  .chip span:hover { background: var(--paper-3); }
  .chip input:checked + span { background: var(--ink); color: #fff; }
  .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .results-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 18px; }
  .results-bar p { margin: 0; color: var(--muted); font-size: .9375rem; }
  .results-bar p :global(strong) { color: var(--ink); font-weight: 600; }
  .results-tools { display: flex; gap: 8px; }
  .sort { width: auto; min-height: 36px; padding: 4px 14px; font-size: .8125rem; border-radius: 999px; }
  .filters-toggle { display: none; }
  .cell[hidden] { display: none; }
  .empty { padding: 64px 0; text-align: center; }
  @media (max-width: 860px) {
    .cat-layout { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .filters { display: none; position: static; max-height: none; background: var(--paper-2); border-radius: var(--radius-lg); padding: 20px; }
    :global(body.filters-open) .filters { display: block; }
    .filters .chip span { background: #fff; }
    .filters .chip input:checked + span { background: var(--ink); }
    .filters-toggle { display: inline-flex; }
  }
</style>
