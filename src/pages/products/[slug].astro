---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import { dimensionArt, rackGeo } from '../../lib/art';
import {
  products, bySku, racks, compatibleAccessories, compatibleRacks, usableDepth, formatRRP, productUrl,
  TYPE_LABEL, GROUP_LABEL, RANGE_LABEL, type Product, type Accessory, type AccGroup,
} from '../../lib/catalog';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: Product };
const price = formatRRP(p);
const equivalent = p.equivalent ? bySku.get(p.equivalent) : null;
const isRack = p.kind === 'rack';
const category = isRack ? TYPE_LABEL[p.type] : GROUP_LABEL[p.group];
const categoryHref = url(isRack ? `/products?kind=rack&type=${p.type}` : `/products?kind=accessory&type=${p.group}`);

// Spec rows: Leader's datasheet rows when we have them, otherwise what the SKU tells us.
let specRows: [string, string][] = p.specs;
if (isRack && !specRows.length) {
  const ud = usableDepth(p);
  specRows = [
    ['Rack units', `${p.ru}U`],
    ['Mounting standard', p.standard === '10' ? '10 inch' : '19 inch'],
    ...(p.width ? [['External width', `${p.width} mm`] as [string, string]] : []),
    ...(p.depth ? [['External depth', `${p.depth} mm`] as [string, string]] : []),
    ...(p.door ? [['Front door', p.door === 'glass' ? 'Glass' : 'Mesh']] as [string, string][] : []),
    ['Usable mounting depth', ud.mm && !ud.estimated ? `${ud.mm} mm` : 'To be confirmed'],
    ['Load rating', p.loadKg ? `${p.loadKg} kg` : 'To be confirmed'],
    ['Finish', p.colour],
  ];
}
if (!isRack && !specRows.length) {
  specRows = [
    ...(p.ru ? [['Rack units', `${p.ru}U`] as [string, string]] : []),
    ['Mounting standard', p.fit.standard === '10' ? '10 inch' : '19 inch'],
    ...(p.shelfDepth ? [['Shelf depth', `${p.shelfDepth} mm`] as [string, string]] : []),
  ];
}
if (p.warrantyMonths) specRows = [...specRows, ['Warranty', `${p.warrantyMonths} months`]];

// Related
let groupedAcc: [AccGroup, Accessory[]][] = [];
if (isRack) {
  const acc = compatibleAccessories(p);
  const groups = new Map<AccGroup, Accessory[]>();
  for (const a of acc) groups.set(a.group, [...(groups.get(a.group) ?? []), a]);
  groupedAcc = [...groups.entries()];
}
const fitsRacks = !isRack ? compatibleRacks(p) : [];
const siblings = isRack
  ? racks.filter((r) => r.sku !== p.sku && r.range === p.range && r.type === p.type).slice(0, 8)
  : [];
const gallery = [p.image, ...p.gallery].filter(Boolean) as string[];
const known = isRack ? rackGeo(p).known : null;
const dimsComplete = !!known && known.W && known.H && known.D && known.usable;
---
<Base title={`${p.name} (${p.sku})`} description={p.summary || `${p.name}, ${p.sku}. ${category} from LDR.`} kind={p.kind}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={url('/')}>Home</a><span aria-hidden="true">/</span>
      <a href={url(isRack ? '/products?kind=rack' : '/products?kind=accessory')}>{isRack ? 'Racks' : 'Accessories'}</a><span aria-hidden="true">/</span>
      <a href={categoryHref}>{category}</a><span aria-hidden="true">/</span>{p.sku}
    </nav>

    <section class="pd">
      <div class="pd-media">
        <ProductImage product={p} size="hero" eager />
        {gallery.length > 1 && (
          <div class="thumbs" aria-label="More images">
            {gallery.map((g, i) => <button type="button" class="thumb" data-src={g} aria-label={`Image ${i + 1}`}><img src={g} alt="" loading="lazy" onerror="this.parentElement.remove()" /></button>)}
          </div>
        )}
      </div>

      <div class="pd-info">
        <div class="badges">
          {p.range === 'carbon' ? <span class="badge badge--carbon">Carbon</span> : <span class="badge">LDR</span>}
          {p.isNew && <span class="badge badge--new">New</span>}
          <span class="badge">{category}</span>
        </div>
        <h1>{p.name}</h1>
        <p class="sku pd-sku">{p.sku} <button type="button" class="copy" data-copy={p.sku}>Copy</button></p>
        {p.summary && <p class="pd-summary">{p.summary}</p>}

        {isRack && (
          <dl class="facts">
            <div><dt>Height</dt><dd>{p.ru}U</dd></div>
            <div><dt>W × D</dt><dd>{p.width && p.depth ? `${p.width} × ${p.depth} mm` : p.type === 'mini' ? '10"' : '—'}</dd></div>
            <div><dt>Usable depth</dt><dd>{p.mountDepth ? `${p.mountDepth} mm` : 'TBC'}</dd></div>
            <div><dt>Load</dt><dd>{p.loadKg ? `${p.loadKg} kg` : 'TBC'}</dd></div>
          </dl>
        )}

        <div class="buybox">
          <p class="price">{price ? <><strong>{price}</strong> <span class="muted">RRP inc GST</span></> : <span>Price on request</span>}</p>
          {p.range === 'carbon' && <p class="notice">Carbon is a new range. Pricing, stock and full datasheets are being finalised: request a quote and your reseller will confirm availability.</p>}
          <div class="actions">
            <a class="btn btn--primary" href={url(`/quote?items=${encodeURIComponent(`${p.sku}:1`)}`)}>Request a quote</a>
            {isRack && <a class="btn btn--secondary" href={url(`/rack-builder?rack=${p.sku}`)}>Plan the fit-out</a>}
            <a class="btn btn--secondary" href={url('/where-to-buy')}>Where to buy</a>
          </div>
          <p class="trade muted">Trade customer? <a href="https://partner.leadersystems.com.au" rel="noopener">Check pricing & stock in the Leader portal ↗</a></p>
        </div>

        {equivalent && (
          <a class="equiv" href={productUrl(equivalent)}>
            <span class="muted">Also in the {RANGE_LABEL[equivalent.range]} range</span>
            <strong>{equivalent.name}</strong> <span class="sku">{equivalent.sku}</span>
          </a>
        )}
      </div>
    </section>

    <section class="pd-detail">
      <div>
        <h2>Specifications</h2>
        <table class="spec-table">
          <tbody>{specRows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
        {p.shipping.length > 0 && (
          <details class="shipping"><summary>Shipping details</summary>
            <table class="spec-table"><tbody>{p.shipping.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
          </details>
        )}
      </div>
      <div>
        {isRack && (<>
          <h2>Dimensions</h2>
          <div class="dims" set:html={dimensionArt(p)} />
          <p class="muted dims-note">Drawn to scale by rack units.{!dimsComplete && ' Measurements not shown are still to be confirmed on the datasheet.'}</p>
        </>)}
        {isRack && p.inBox.length > 0 && (<><h2>In the box</h2><ul class="ticks">{p.inBox.map((i) => <li>{i}</li>)}</ul></>)}
        {p.features.length > 0 && (<><h2>Features</h2><ul class="ticks">{p.features.map((f) => <li>{f}</li>)}</ul></>)}
        <h2>Downloads</h2>
        {p.datasheet
          ? <a class="download" href={p.datasheet} rel="noopener">Datasheet (PDF) ↗</a>
          : <p class="muted">Datasheet coming soon.</p>}
      </div>
    </section>

    {isRack && groupedAcc.length > 0 && (
      <section class="related">
        <div class="section-head"><h2>Fits this cabinet</h2><a class="link-arrow" href={url(`/rack-builder?rack=${p.sku}`)}>Plan a full fit-out →</a></div>
        <p class="muted fit-note">Matched on mounting standard, cabinet type and depth. Shelf depths follow Leader's recommendations; check equipment depth before ordering.</p>
        {groupedAcc.map(([g, list]) => (
          <div class="acc-group">
            <h3>{GROUP_LABEL[g]}</h3>
            <div class="grid grid--4">{list.slice(0, 8).map((a) => <ProductCard product={a} />)}</div>
          </div>
        ))}
      </section>
    )}

    {!isRack && fitsRacks.length > 0 && (
      <section class="related">
        <h2>Fits these cabinets</h2>
        <div class="fits-list">
          {fitsRacks.map((r) => <a href={productUrl(r)} class="fit-pill"><strong>{r.name}</strong><span class="sku">{r.sku}</span></a>)}
        </div>
      </section>
    )}

    {siblings.length > 0 && (
      <section class="related">
        <h2>Other sizes</h2>
        <div class="grid grid--4">{siblings.map((s) => <ProductCard product={s} />)}</div>
      </section>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1500); } catch {}
  }));
  const hero = document.querySelector<HTMLImageElement>('.pd-media .pimg img');
  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((t) => t.addEventListener('click', () => {
    if (hero) hero.src = t.dataset.src!;
    document.querySelectorAll('.thumb').forEach((x) => x.removeAttribute('aria-current'));
    t.setAttribute('aria-current', 'true');
  }));
</script>

<style>
  .pd { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(28px, 4.5vw, 64px); padding: 22px 0 64px; align-items: start; }
  .pd-media { position: sticky; top: calc(var(--header-h) + 20px); }
  .thumbs { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .thumb { width: 68px; height: 68px; border: 1.5px solid transparent; border-radius: 14px; background: var(--paper-2); padding: 6px; cursor: pointer; transition: border-color .2s; }
  .thumb:hover { border-color: var(--line-strong); }
  .thumb[aria-current] { border-color: var(--ink); }
  .thumb img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; }
  .pd-info { padding-top: clamp(0px, 2vw, 24px); }
  .pd-info h1 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); margin-bottom: .2em; }
  .pd-sku { display: flex; align-items: center; gap: 10px; font-size: .8125rem; margin: 0; }
  .copy { border: 0; background: var(--paper-2); border-radius: 999px; font: 500 .72rem var(--font-sans); padding: 4px 10px; cursor: pointer; color: var(--ink-2); transition: background .2s; }
  .copy:hover { background: var(--paper-3); }
  .pd-summary { color: var(--ink-2); margin-top: 18px; font-size: 1.0625rem; line-height: 1.5; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 24px 0; }
  .facts div { padding: 14px; border-radius: 16px; background: var(--paper-2); }
  .facts dt { font-size: .72rem; font-weight: 500; color: var(--muted); }
  .facts dd { margin: 3px 0 0; font-weight: 600; font-size: 1.0625rem; letter-spacing: -.02em; }
  .buybox { border-top: 1px solid var(--line); padding-top: 22px; margin-top: 24px; display: grid; gap: 16px; }
  .price { margin: 0; font-size: .9375rem; }
  .price strong { font-size: 1.875rem; font-weight: 600; letter-spacing: -.03em; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .trade { font-size: .8125rem; margin: 0; }
  .equiv { display: grid; gap: 2px; margin-top: 22px; padding: 16px 18px; border-radius: var(--radius-lg); background: var(--paper-2); text-decoration: none; transition: background .2s; }
  .equiv:hover { background: var(--paper-3); }
  .equiv .muted { font-size: .78rem; }
  .pd-detail { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4.5vw, 64px); padding: 48px 0; border-top: 1px solid var(--line); }
  .pd-detail h2 { font-size: 1.375rem; margin-top: 0; }
  .pd-detail h2:not(:first-child) { margin-top: 36px; }
  .dims { background: var(--paper-2); border-radius: var(--radius-lg); padding: 22px; }
  .dims :global(svg) { width: 100%; height: auto; max-height: 340px; }
  .dims-note { font-size: .78rem; margin: 10px 0 0; }
  .ticks { padding-left: 1.1em; margin: 0; display: grid; gap: 7px; color: var(--ink-2); }
  .shipping { margin-top: 18px; }
  .shipping summary { cursor: pointer; font-weight: 500; font-size: .9375rem; padding: 8px 0; color: var(--accent); }
  .download { display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: 999px; background: var(--paper-2); text-decoration: none; font-weight: 500; font-size: .9375rem; transition: background .2s; }
  .download:hover { background: var(--paper-3); }
  .related { padding: 48px 0; border-top: 1px solid var(--line); }
  .related h2 { font-size: clamp(1.4rem, 2.4vw, 1.75rem); }
  .fit-note { margin-top: -14px; font-size: .875rem; }
  .acc-group { margin-top: 28px; }
  .acc-group h3 { font-size: .9375rem; margin-bottom: 12px; color: var(--muted); font-weight: 500; }
  .fits-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 8px; }
  .fit-pill { display: grid; padding: 12px 16px; border-radius: 14px; background: var(--paper-2); text-decoration: none; transition: background .2s; }
  .fit-pill:hover { background: var(--paper-3); }
  .fit-pill strong { font-size: .9375rem; font-weight: 500; }
  @media (max-width: 860px) {
    .pd, .pd-detail { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .pd-media { position: static; }
    .facts { grid-template-columns: 1fr 1fr; }
  }
</style>
