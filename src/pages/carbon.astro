---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { racks, accessories, bySku, TYPE_LABEL, GROUP_LABEL, type Rack, type RackType, type AccGroup } from '../lib/catalog';
import { lineupArt } from '../lib/art';

const carbonRacks = racks.filter((r) => r.range === 'carbon');
const carbonAcc = accessories.filter((a) => a.range === 'carbon');
const rackGroups = (['wall', 'floor', 'mini', 'vertical', 'bracket'] as RackType[])
  .map((t) => [t, carbonRacks.filter((r) => r.type === t)] as const).filter(([, l]) => l.length);
const accGroups = [...new Set(carbonAcc.map((a) => a.group))] as AccGroup[];
const lineup = ['RCLDR-MR10-4U-CARBON', 'RCLDR-SS450-6U-CARBON', 'RCLDR-SS450-12U-CARBON', 'RCLDR-SS450-18U-CARBON',
  'RCLDR-FS600-22U-CARBON', 'RCLDR-FS800-27U-CARBON', 'RCLDR-FS600-32U-CARBON', 'RCLDR-FS1000-42U-CARBON', 'RCLDR-FWMAX-47U-CARBON']
  .map((s) => bySku.get(s)).filter((p): p is Rack => p?.kind === 'rack');
const ruSpan = (t: RackType) => { const l = carbonRacks.filter((r) => r.type === t).map((r) => r.ru); return `${Math.min(...l)}U–${Math.max(...l)}U`; };
---
<Base title="Carbon range" description="LDR Carbon: a new range of wall, floor and 10-inch cabinets with matching shelves, doors, plinths and cable management.">
  <section class="c-hero">
    <div class="wrap">
      <img src="/brand/ldr-carbon-light.png" alt="LDR Carbon" width="233" height="84" class="c-logo" />
      <p class="lede">A new generation of LDR cabinets in a charcoal finish, with a fit-out range designed alongside it: spare doors, plinths, vertical cable managers, baying and earthing kits.</p>
      <nav class="c-jump" aria-label="Carbon range sections">
        {rackGroups.map(([t]) => <a href={`#${t}`}>{TYPE_LABEL[t]}</a>)}
        <a href="#fit-out">Fit-out</a>
      </nav>
      <figure class="lineup">
        <div class="lineup-scroll"><div class="lineup-art" set:html={lineupArt(lineup, { labels: true })} /></div>
        <figcaption>Illustrations, drawn to one scale by rack units. Select a cabinet for its details.</figcaption>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <p class="notice c-status">Carbon is launching now. Pricing, stock and datasheets are being finalised; request a quote and your reseller will confirm availability and lead time.</p>

    <section class="c-overview">
      <div class="c-stat"><strong>{carbonRacks.filter((r) => r.type === 'wall').length}</strong><span>Wall cabinets · {ruSpan('wall')}</span><p>600 mm wide, 450 or 600 mm deep, glass front.</p></div>
      <div class="c-stat"><strong>{carbonRacks.filter((r) => r.type === 'floor').length}</strong><span>Floor cabinets · {ruSpan('floor')}</span><p>600 or 800 mm wide, 600 to 1100 mm deep. Glass or mesh fronts.</p></div>
      <div class="c-stat"><strong>{carbonRacks.filter((r) => r.type === 'mini').length}</strong><span>10" mini racks · {ruSpan('mini')}</span><p>For 10-inch gear in tight spaces.</p></div>
      <div class="c-stat"><strong>{carbonAcc.length}</strong><span>Fit-out parts</span><p>Shelves, blanking, doors, plinths, cable and cooling parts.</p></div>
    </section>

    {rackGroups.map(([t, list]) => (
      <section class="c-group" id={t}>
        <div class="section-head"><h2>Carbon {TYPE_LABEL[t].toLowerCase()}</h2><a class="link-arrow" href={`/products?range=carbon&kind=rack&type=${t}`}>Filter & compare →</a></div>
        <div class="grid grid--4">{list.map((p) => <ProductCard product={p} />)}</div>
      </section>
    ))}

    <section class="c-group" id="fit-out">
      <div class="section-head"><h2>Carbon fit-out</h2><a class="link-arrow" href="/products?range=carbon&kind=accessory">All Carbon accessories →</a></div>
      {accGroups.map((g) => (
        <div class="acc-block">
          <h3>{GROUP_LABEL[g]}</h3>
          <div class="grid grid--4">{carbonAcc.filter((a) => a.group === g).map((p) => <ProductCard product={p} />)}</div>
        </div>
      ))}
    </section>

    <section class="c-cta">
      <div>
        <h2>Not sure which size?</h2>
        <p class="muted">The Rack Builder sizes a Carbon cabinet from your equipment list and adds the matching fit-out.</p>
      </div>
      <a class="btn btn--primary" href="/rack-builder?range=carbon">Build a Carbon rack</a>
    </section>
  </div>
</Base>

<style>
  .c-hero { background: var(--charcoal); color: #f5f5f7; padding: clamp(56px, 8vw, 104px) 0 clamp(40px, 6vw, 72px); text-align: center; }
  .c-hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; }
  .c-logo { height: clamp(64px, 9vw, 104px); width: auto; margin-bottom: 26px; }
  .c-hero .lede { color: #a1a1a6; }
  .c-jump { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 26px; }
  .c-jump a { color: #f5f5f7; text-decoration: none; background: rgb(255 255 255 / .1); border-radius: 999px; padding: 8px 16px; font-size: .875rem; font-weight: 500; transition: background .2s; }
  .c-jump a:hover { background: rgb(255 255 255 / .2); }
  .lineup { width: 100%; margin: clamp(40px, 6vw, 72px) 0 0; }
  .lineup-scroll { overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter); }
  .lineup-scroll::-webkit-scrollbar { display: none; }
  .lineup-art { min-width: 760px; }
  .lineup-art :global(svg) { width: 100%; height: auto; overflow: visible; }
  .lineup-art :global(.lu-item) { transition: filter .3s; cursor: pointer; }
  .lineup-art :global(.lu-item:hover) { filter: brightness(1.5); }
  .lineup figcaption { margin-top: 22px; font-size: .75rem; color: #86868b; }
  .c-status { margin: 32px 0 0; }
  .c-overview { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 20px 0 16px; }
  .c-stat { background: var(--paper-2); border-radius: var(--radius-lg); padding: 24px; display: grid; gap: 4px; align-content: start; }
  .c-stat strong { font-size: 2.75rem; font-weight: 600; letter-spacing: -.04em; line-height: 1; }
  .c-stat span { font-weight: 600; font-size: .9375rem; margin-top: 6px; }
  .c-stat p { margin: 2px 0 0; color: var(--muted); font-size: .875rem; }
  @media (max-width: 860px) { .c-overview { grid-template-columns: 1fr 1fr; } }
  .c-group { padding: 48px 0 8px; scroll-margin-top: 80px; }
  .acc-block { margin-bottom: 32px; }
  .acc-block h3 { font-size: .9375rem; margin-bottom: 12px; color: var(--muted); font-weight: 500; }
  .c-cta { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: var(--paper-2); border-radius: var(--radius-xl); margin: 56px 0 96px; padding: clamp(28px, 4vw, 48px); }
  .c-cta h2 { margin-bottom: .2em; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .c-cta p { margin: 0; }
</style>
