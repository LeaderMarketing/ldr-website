---
import { url } from '../lib/url';
import '../styles/global.css';
import { nav, site } from '../data/site';

interface Props { title: string; description?: string; active?: string; kind?: 'rack' | 'accessory' }
const { title, description = site.tagline, active, kind } = Astro.props;
const fullTitle = title === 'LDR' ? 'LDR | Data racks & cabinets' : `${title} | LDR`;
const path = Astro.url.pathname;
// Links with a query (Racks / Accessories) share /products, so they're highlighted client-side.
const isActive = (href: string) => active ? href.startsWith(active) : !href.includes('?') && url(href) === path.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A build under a subpath is the GitHub Pages preview: keep it out of search engines.
const isPreview = base !== '';
---
<!doctype html>
<html lang="en-AU" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('/brand/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-kind={kind}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href={url('/')} class="logo" aria-label="LDR home"><img src={url('/brand/ldr-dark.png')} alt="LDR" width="103" height="22" /></a>
        <nav aria-label="Main" class="nav-desktop">
          {nav.map((n) => <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="bar-actions">
          <form action={url('/products')} class="search" role="search">
            <label for="q" class="visually-hidden">Search products</label>
            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="5.5" /><path d="m13.5 13.5 3.5 3.5" /></svg>
            <input id="q" name="q" type="search" placeholder="Search" autocomplete="off" />
          </form>
          <a class="btn btn--ink btn--small" href={url('/quote')}>Request a quote</a>
          <details class="nav-mobile">
            <summary aria-label="Menu"><span></span><span></span></summary>
            <nav aria-label="Mobile">
              <form action={url('/products')} role="search"><input name="q" type="search" class="input" placeholder="Search SKU or product" aria-label="Search products" /></form>
              {nav.map((n) => <a href={url(n.href)}>{n.label}</a>)}
              <a href={url('/quote')}>Request a quote</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>
    <script is:inline>
      (function () {
        var kind = new URLSearchParams(location.search).get('kind');
        var base = document.documentElement.dataset.base || '';
        var pathname = location.pathname.slice(base.length) || '/';
        var onProduct = /^\/products\/./.test(pathname);
        document.querySelectorAll('.nav-desktop a[href*="/products?kind="]').forEach(function (a) {
          var k = a.getAttribute('href').split('kind=')[1];
          if ((pathname.replace(/\/$/, '') === '/products' && kind === k) ||
              (onProduct && document.body.dataset.kind === k)) a.setAttribute('aria-current', 'page');
        });
        // The photo of the product being opened travels to the product page (view transitions).
        var named;
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a.pcard-link');
          var im = a && a.querySelector('.pimg');
          if (!im) return;
          if (named) named.style.viewTransitionName = '';
          document.querySelectorAll('.pimg--hero').forEach(function (h) { h.style.viewTransitionName = 'none'; });
          im.style.viewTransitionName = 'product-image';
          named = im;
        }, true);
        // Sections ease in as they scroll into view.
        var items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { items.forEach(function (el) { el.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        items.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <img src={url('/brand/ldr-dark.png')} alt="LDR" width="103" height="22" />
            <p class="foot-blurb">LDR data racks and accessories are distributed in Australia by Leader Systems and sold through resellers and integrators.</p>
          </div>
          <div>
            <h4>Products</h4>
            <a href={url('/products?kind=rack&type=wall')}>Wall cabinets</a>
            <a href={url('/products?kind=rack&type=floor')}>Floor cabinets</a>
            <a href={url('/carbon')}>Carbon range</a>
            <a href={url('/products?kind=accessory')}>Accessories</a>
          </div>
          <div>
            <h4>Plan</h4>
            <a href={url('/rack-builder')}>Rack Builder</a>
            <a href={url('/support#choosing')}>Choosing a rack</a>
            <a href={url('/support#downloads')}>Datasheets</a>
          </div>
          <div>
            <h4>Buy</h4>
            <a href={url('/where-to-buy')}>Where to buy</a>
            <a href={url('/quote')}>Request a quote</a>
            <a href={site.tradePortal} rel="noopener">Leader trade portal ↗</a>
            <a href={url('/about')}>About LDR</a>
          </div>
        </div>
        <p class="foot-legal">© {new Date().getFullYear()} LDR · Leader Systems. Prices shown are RRP in AUD including GST and may change. Trade pricing via the Leader portal.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 100; background: #fff; padding: 8px 14px; border-radius: 999px; box-shadow: var(--shadow); }

  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / .78); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); border-bottom: 1px solid rgb(0 0 0 / .07); }
  .bar { display: flex; align-items: center; gap: 32px; height: var(--header-h); }
  .logo { display: block; flex: none; }
  .logo img { height: 19px; width: auto; }
  .nav-desktop { display: flex; gap: 4px; }
  .nav-desktop a { color: var(--ink-2); text-decoration: none; font-size: .875rem; padding: 7px 12px; border-radius: 999px; transition: background .2s, color .2s; }
  .nav-desktop a:hover { background: rgb(0 0 0 / .05); color: var(--ink); }
  .nav-desktop a[aria-current] { color: var(--ink); font-weight: 600; background: rgb(0 0 0 / .05); }
  .bar-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .search { position: relative; color: var(--muted); }
  .search svg { position: absolute; left: 11px; top: 50%; translate: 0 -50%; pointer-events: none; }
  .search input { width: 150px; height: 34px; border-radius: 999px; border: 1px solid transparent; background: rgb(0 0 0 / .05); color: var(--ink); padding: 0 12px 0 32px; font-size: .875rem; transition: width .35s var(--ease), background .2s, border-color .2s; }
  .search input::placeholder { color: var(--muted); }
  .search input:focus { width: 230px; outline: none; background: #fff; border-color: var(--accent); }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; margin-right: -10px; }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary span { display: block; width: 18px; height: 1.5px; background: var(--ink); border-radius: 2px; transition: transform .3s var(--ease); }
  .nav-mobile[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav-mobile[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .nav-mobile nav { position: fixed; left: 0; right: 0; top: var(--header-h); bottom: 0; overflow: auto; background: #fff; padding: 16px var(--gutter) 32px; display: grid; align-content: start; gap: 0; }
  .nav-mobile nav a { padding: 14px 0; text-decoration: none; border-bottom: 1px solid var(--line); font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; }
  .nav-mobile nav form { margin-bottom: 8px; }
  @media (max-width: 1100px) { .search { display: none; } .bar { gap: 20px; } }
  @media (max-width: 900px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
    .bar-actions .btn { display: none; }
  }

  .site-footer { background: var(--paper-2); color: var(--ink-2); padding: 56px 0 28px; font-size: .875rem; }
  .foot-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 32px; }
  .foot-grid h4 { font-size: .8125rem; font-weight: 600; color: var(--ink); margin-bottom: 10px; letter-spacing: -.005em; }
  .foot-grid a { display: block; text-decoration: none; color: var(--muted); padding: 4px 0; }
  .foot-grid a:hover { color: var(--ink); }
  .foot-grid img { height: 19px; width: auto; margin-bottom: 16px; }
  .foot-blurb { max-width: 36ch; color: var(--muted); }
  .foot-legal { border-top: 1px solid var(--line); margin: 40px 0 0; padding-top: 20px; font-size: .75rem; color: var(--muted); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-grid > div:first-child { grid-column: 1 / -1; } }
</style>
